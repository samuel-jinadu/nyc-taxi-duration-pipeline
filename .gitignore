# === Airflow ===
# Local Airflow runtime artifacts
airflow.cfg
airflow.db
airflow.db-journal
webserver_config.py
airflow-webserver.pid
airflow-webserver-monitor.pid
airflow-scheduler.pid
airflow-scheduler.err
airflow-scheduler.log
airflow-webserver.err
airflow-webserver.log
standalone_admin_password.txt

# Runtime data (keep dirs, ignore contents)
logs/*
!logs/.gitkeep
plugins/*
!plugins/.gitkeep

# Compiled DAGs / cache
dags/__pycache__/
dags/**/__pycache__/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# === uv ===
# Keep pyproject.toml and uv.lock tracked; ignore uv's local cache
.uv/
uv-cache/

# === Environment / secrets ===
# Keep .env for local dev if you want, but never commit real secrets.
# Uncomment the next line to ignore it entirely:
# .env
.env.local
.env.*.local
*.pem
*.key

# === Docker ===
# If you later add a compose override for local secrets
compose.override.yaml
compose.override.yml

# === Editors / OS ===
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === Project-specific ===
# Snapshots generated by scripts/pack-proj.sh
scripts/project_snapshot.txt